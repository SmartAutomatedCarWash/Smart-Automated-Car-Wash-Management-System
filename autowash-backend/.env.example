# ============================================================
# AutoWash Backend – Environment Configuration
# Copy file này thành .env trước khi chạy:
#   cp .env.example .env
# ============================================================

# Google OAuth - Lấy từ Google Cloud Console
AUTOWASH_GOOGLE_CLIENT_ID=your-google-client-id
AUTOWASH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database - Đổi theo PostgreSQL local của bạn
AUTOWASH_DB_URL=jdbc:postgresql://localhost:5432/autowash
AUTOWASH_DB_USERNAME=postgres
AUTOWASH_DB_PASSWORD=your-db-password

# Mail - Dùng Resend hoặc SMTP
AUTOWASH_MAIL_PROVIDER=resend
AUTOWASH_MAIL_HOST=smtp.resend.com
AUTOWASH_MAIL_PORT=587
AUTOWASH_MAIL_USERNAME=resend
AUTOWASH_MAIL_PASSWORD=your-resend-api-key
AUTOWASH_MAIL_FROM=no-reply@mail.auracarwash.site
AUTOWASH_MAIL_FROM_NAME=AURA Car Wash
AUTOWASH_RESEND_API_KEY=your-resend-api-key

# Cloudflare R2 Storage - Xin credentials từ nhóm trưởng
AUTOWASH_S3_ENABLED=true
AUTOWASH_S3_REGION=auto
AUTOWASH_S3_BUCKET=autowash-avatars
AUTOWASH_S3_ACCESS_KEY=your-r2-access-key
AUTOWASH_S3_SECRET_KEY=your-r2-secret-key
AUTOWASH_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AUTOWASH_S3_PUBLIC_BASE_URL=https://pub-your-id.r2.dev
AUTOWASH_S3_UPLOAD_URL_TTL=300
AUTOWASH_S3_MAX_AVATAR_SIZE_BYTES=5242880
